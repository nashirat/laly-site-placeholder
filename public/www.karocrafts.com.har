wfY3fc4bHWiuJH_LogoKaro.png?auto=format%2Ccompress&amp;rect=0%2C8%2C685%2C685&amp;w=1245&amp;h=1245\" media=\"(min-width: 1240px)\"><source srcset=\"https://images.prismic.io/studio-karo/aFwfY3fc4bHWiuJH_LogoKaro.png?auto=format%2Ccompress&amp;rect=0%2C8%2C685%2C685&amp;w=1245&amp;h=1245\" media=\"(min-width: 768px)\"><source srcset=\"https://images.prismic.io/studio-karo/aFwfY3fc4bHWiuJH_LogoKaro.png?auto=format%2Ccompress&amp;rect=0%2C8%2C685%2C685&amp;w=1245&amp;h=1245\" media=\"(orientation: portrait) and (min-width: 1240px)\"><source srcset=\"https://images.prismic.io/studio-karo/aFwfY3fc4bHWiuJH_LogoKaro.png?auto=format%2Ccompress&amp;rect=0%2C8%2C685%2C685&amp;w=1245&amp;h=1245\" media=\"(orientation: portrait) and (min-width: 840px)\"><source srcset=\"https://images.prismic.io/studio-karo/aFwfY3fc4bHWiuJH_LogoKaro.png?auto=format%2Ccompress&amp;rect=0%2C8%2C685%2C685&amp;w=500&amp;h=500\" media=\"(min-width: 640px)\"><source srcset=\"https://images.prismic.io/studio-karo/aFwfY3fc4bHWiuJH_LogoKaro.png?auto=format%2Ccompress&amp;rect=0%2C8%2C685%2C685&amp;w=500&amp;h=500\" media=\"(min-width: 450px)\"><!--]--><img class=\"responsive-img-el w-1/1\" src=\"https://images.prismic.io/studio-karo/aFwfY3fc4bHWiuJH_LogoKaro.png?auto=format%2Ccompress&amp;rect=0%2C8%2C685%2C685&amp;w=500&amp;h=500\" alt=\"Studio Karo 3D logo\" width=\"500\" height=\"500\" loading=\"lazy\"></picture></div><div class=\"text-right landscape:w-5/16 z-1\"><div class=\"text-xxl tracking-normal leading-[0.8] font-(--f-bold) mb-[2.51svh] landscape:mb-[7.34svh]\"><!--[--><!--[--><p><!--[--><!--[--><!--[--><!--[--><!---->making mixed <!--]--><!--[--><br>media art, <!--]--><!--[--><br>clothing, video, <!--]--><!--[--><br>&amp; other whimsical <!--]--><!--[--><br>miscellaneous <!--]--><!--[--><br>design projects.<!--]--><!--]--><!--]--><!--]--></p><!--]--><!--]--></div><div class=\"text-big-p landscape:text-small-p [&amp;&gt;p]:mb-[1em] leading-[0.8] tracking-tight\"><!--[--><!--[--><p><!--[--><!--[--><!--[--><!--[--><!---->Founded in 2023,<!--]--><!--[--><br>Studio KARO is the physical extension<!--]--><!--[--><br>of the ever-evolving Karoverse<!--]--><!--]--><!--]--><!--]--></p><p><!--[--><!--[--><!--[--><!--[--><!---->- part workshop,<!--]--><!--[--><br>part wonderland.<!--]--><!--]--><!--]--><!--]--></p><!--]--><!--]--></div></div></div></section><section id=\"playlists\" data-slice-type=\"media_collection_display\" data-slice-variation=\"main_with_info_and_carousel\" class=\"py-[6.28svh] relative landscape:py-[9.75svh]\"><div style=\"--ref-size:var(--grid-width) * 0.065;\" class=\"px-(--grid-margin) relative z-2 text-small-p tracking-tight flex justify-between with-block-pseudo with-brackets w-1/2 mx-auto landscape:w-25/160 landscape:mx-auto mb-[5.27svh] uppercase\"><!--[--><!--[--><h2><!--[--><!--[--><!--[--><!--[--><!---->Playlists<!--]--><!--]--><!--]--><!--]--></h2><!--]--><!--]--></div><div class=\"flex justify-between flex-wrap\"><div class=\"px-(--grid-margin) order-1 landscape:order-[unset] landscape:w-5/16 landscape:flex landscape:flex-col landscape:justify-between landscape:relative landscape:z-3\"><div><div class=\"text-xxxl tracking-normal leading-[0.8] font-(--f-bold) mb-[2.76svh] landscape:mb-[0.18em]\"><!--[--><!--[--><p><!--[--><!--[--><!--[--><!--[--><!---->The<!--]--><!--[--><br>Playlists:<!--]--><!--]--><!--]--><!--]--></p><!--]--><!--]--></div><div class=\"text-small-p tracking-tight with-p-brackets uppercase\"><!--[--><!--[--><p><!--[--><!--[--><!--[--><!--[--><!---->Creative mixtapes<!--]--><!--]--><!--]--><!--]--></p><!--]--><!--]--></div></div><div class=\"hidden landscape:block w-4/10 leading-[1] tracking-tight\">VOL 1: \nSTARGIRL</div></div><div class=\"flex flex-col items-center w-1/1 overflow-hidden order-2 landscape:order-[unset] landscape:absolute landscape:z-0 landscape:top-0 pointer-events-none\"><img onerror=\"this.setAttribute(&#39;data-error&#39;, 1)\" alt=\"playlist cover\" data-nuxt-img srcset=\"/_vercel/image?url=%2