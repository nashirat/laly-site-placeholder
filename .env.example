# Payload (added in the Payload phase)
MONGODB_URL=mongodb://127.0.0.1/laly-web
PAYLOAD_SECRET=change-me
BLOB_READ_WRITE_TOKEN=
# Seed-only. `ADMIN_PASSWORD=... bun run seed` creates or rotates the /admin login. Never set in
# Vercel — nothing reads it at runtime, and it would sit in the dashboard as a plaintext credential.
ADMIN_PASSWORD=

# ISR on-demand revalidation
REVALIDATE_SECRET=change-me

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Booking dialog -------------------------------------------------------------------------
# Business hours the slot picker offers, in BOOKING_TZ (the AGENCY's zone, not the visitor's —
# the dialog converts for display). See src/lib/slots.ts.
BOOKING_TZ=America/New_York
BOOKING_OPEN_HOUR=9
BOOKING_CLOSE_HOUR=17

# Google CALENDAR (not the Meet API — Meet v2 manages spaces and has no scheduling). Unset today:
# /api/booking is a stub that logs the lead and sends nothing. Filling these in is what flips the
# `invited` flag in that route true, which is what the confirmation screen words itself off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
